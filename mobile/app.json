{
  "expo": {
    "name": "YachtPA",
    "slug": "yachtpa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yachtpa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yachtpa.app",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07192B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yachtpa.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07192B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "YachtPA uses your location between START and STOP to log a voyage.",
          "locationAlwaysAndWhenInUsePermission": "Allow “Always” so YachtPA keeps logging your voyage with the phone locked. Location is only used between START and STOP.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "YachtPA listens while you say what you did today, so it can write up your log.",
          "speechRecognitionPermission": "YachtPA turns what you say into your daily log, on the phone where it can, so it works at sea.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-sharing",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "d34a1130-1033-474d-a1bb-5661d73e9c0c"
      }
    },
    "owner": "ilanagenbacht",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/d34a1130-1033-474d-a1bb-5661d73e9c0c"
    }
  }
}
