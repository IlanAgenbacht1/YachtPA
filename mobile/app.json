{
  "expo": {
    "name": "YachtPA",
    "slug": "yachtpa",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yachtpa",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.yachtpa.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#07192B",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.yachtpa.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#07192B",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "YachtPA uses your location between START VOYAGE and STOP VOYAGE to log miles, time underway and night hours.",
          "locationAlwaysAndWhenInUsePermission": "Allow location all the time so YachtPA can keep logging a voyage you started while the screen is off. Tracking stops when you press STOP VOYAGE.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-task-manager",
      [
        "expo-notifications",
        {
          "color": "#07192B"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "YachtPA records your spoken daily log so it can be written up for you.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Take a photo of a certificate to keep it in your document wallet.",
          "photosPermission": "Pick a photo of a certificate to keep it in your document wallet."
        }
      ],
      "expo-document-picker",
      "expo-sharing",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "YachtPA records your spoken daily log so it can be written up for you.",
          "speechRecognitionPermission": "YachtPA turns what you say into your daily log, on the phone where it can, so it works at sea.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
